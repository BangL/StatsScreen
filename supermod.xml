<?xml version="1.0"?>
<mod name="Stats Screen" image="icon.png"
	description="Adds a lifetime statistics screen (kills, weapons, accuracy, missions, play time) to the Raid menu"
	author="BangL"
	color="60 60 60"
	version="1.2.3"
	min_sblt_version="2.0.0">
	<updates>
		<update identifier="statsscreen">
			<host meta="https://raw.githubusercontent.com/BangL/raid-mods-meta/main/statsscreen.json" patchnotes="https://github.com/BangL/StatsScreen/blob/main/CHANGELOG.md"/>
		</update>
	</updates>
	<localization directory="loc">
		<loc file="english.json" language="english" />
		<loc file="german.json" language="german" />
	</localization>
	<hooks>
		<post hook_id="lib/managers/menu/menucomponentmanager" script_path="StatsScreen.lua" />
	</hooks>
</mod>
